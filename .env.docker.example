# ==============================================================================
# Environment Configuration for Docker Deployment
# ==============================================================================
APP_NAME="Inventaris Perangkat TI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Docker MariaDB Service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=it_inventaris
DB_USERNAME=it_user
DB_PASSWORD=it_secret123
DB_ROOT_PASSWORD=root_secret123

# Session & Cache via Database
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Docker Port Mapping
DOCKER_WEB_PORT=8000
DOCKER_DB_PORT=33060
